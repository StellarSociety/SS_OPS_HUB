# SS Ops Hub — environment template (safe to commit; NO real values)
# Copy to .env.local and fill in.
# Live values are already in .env.local (gitignored).

# --- Supabase (project ref: ymimzwpxqjluwbluglkv) ---
NEXT_PUBLIC_SUPABASE_URL=https://ymimzwpxqjluwbluglkv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.ymimzwpxqjluwbluglkv.supabase.co:5432/postgres

# --- Resend ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@orillarestaurant.com

# --- App secrets (AES-256-GCM for mailbox app passwords + WorkDrive OAuth secrets) ---
# Prefer a dedicated 32+ char random string. If unset, SUPABASE_SERVICE_ROLE_KEY is hashed as fallback.
APP_SECRETS_KEY=

# --- Zoho WorkDrive OAuth (server-only — never NEXT_PUBLIC_*) ---
# Self Client (.com). Scopes: WorkDrive.files.ALL,WorkDrive.workspace.ALL,
# WorkDrive.teamfolders.ALL,WorkDrive.team.READ
# Exchange grant code: node --env-file=.env.local scripts/zoho-exchange-code.mjs <code>
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.com
ZOHO_WORKDRIVE_API_BASE=https://www.zohoapis.com/workdrive/api/v1
ZOHO_REFRESH_TOKEN=

# --- Zoho WorkDrive HR module (legacy / Drive Setup — never NEXT_PUBLIC_*) ---
# Self Client at api-console.zoho.com as people@orillarestaurant.com
# Scopes: WorkDrive.files.ALL,WorkDrive.teamfolders.READ
# (files.ALL is required for in-app preview / download; CREATE+UPDATE+READ is not enough)
ZOHO_WD_REGION=com
ZOHO_WD_CLIENT_ID=
ZOHO_WD_CLIENT_SECRET=
ZOHO_WD_REFRESH_TOKEN=
# Verified live folder IDs (Orilla, 2026-08-02) — also seeded as Drive Setup defaults
ZOHO_WD_TEAM_FOLDER_ID=sae44cf1e2c4af89c4b2db0cbfcf01bcb006a
ZOHO_WD_HR_FOLDER_ID=sae44cf1e2c4af89c4b2db0cbfcf01bcb006a
ZOHO_WD_EMPLOYEE_DOCS_FOLDER_ID=vtvbm62a07bbd35f041bd996fea000998c43a
# Optional — Assets module (uniform piece photos → Assets Pictures)
ZOHO_WD_ASSETS_FOLDER_ID=
ZOHO_WD_ASSETS_PICTURES_FOLDER_ID=

# --- Vercel (project: ss-ops-hub / prj_ms8ZlRIvGI6jOdbyZrOXzhzvDICv) ---
VERCEL_PROJECT_ID=prj_ms8ZlRIvGI6jOdbyZrOXzhzvDICv
AI_GATEWAY_API_KEY=

# --- App ---
# Local: http://localhost:3000
# Production: https://opshub.stellarsocietygroup.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional override used in outbound email if NEXT_PUBLIC_APP_URL is localhost:
# NEXT_PUBLIC_APP_URL_PROD=https://opshub.stellarsocietygroup.com
# NEXT_PUBLIC_SITE_URL=https://opshub.stellarsocietygroup.com

# --- Google reviews (Sentiment) ---
# OAuth web client for Google Business Profile (full reviews + later replies).
# Redirect URIs (both required):
#   https://opshub.stellarsocietygroup.com/api/sentiment/google/callback
#   http://localhost:3000/api/sentiment/google/callback
# Scope: https://www.googleapis.com/auth/business.manage
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Places API (New) key — optional fallback. Prefer saving the key in
# Sentiment → Settings. Imports the public Google listing (up to 5 reviews).
GOOGLE_PLACES_API_KEY=

# --- Cron (Vercel scheduled jobs) ---
# Generate a random secret; set the same value in Vercel env vars.
# Vercel sends it as Authorization: Bearer <CRON_SECRET> on cron invocations.
CRON_SECRET=

# --- ZKTeco / device attendance sync (restaurant PC agent → POST /api/attendance/punch) ---
# Shared secret in the JSON body field "secret". Optional per-venue override:
# ATTENDANCE_PUNCH_SECRET_ORILLA=...
ATTENDANCE_PUNCH_SECRET=

# --- Sentry ---
SENTRY_DSN=
