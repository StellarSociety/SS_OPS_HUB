{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "NODE_OPTIONS='--max-old-space-size=6144' pnpm --filter @ss-ops-hub/web build",
  "framework": "nextjs",
  "outputDirectory": "apps/web/.next",
  "crons": [
    {
      "path": "/api/cron/notifications",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/boarding-emails",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/work-anniversary-emails",
      "schedule": "15 5 * * *"
    },
    {
      "path": "/api/cron/sentiment-google",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/sentiment-apify",
      "schedule": "30 6 * * *"
    }
  ]
}
